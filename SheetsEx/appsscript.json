{
  "timeZone": "Asia/Tokyo",
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "dependencies": {
    "libraries": [
      {
        "userSymbol": "StudioWrapper",
        "libraryId": "1XhLWjQhiO25oEYIf_ygF_AZ7GKOLvXMz1VF8ivqXB-vkkvx8d0H5IrWD",
        "version": "1"
      }
    ]
  },
  "oauthScopes": [
    "https://www.googleapis.com/auth/spreadsheets"
  ],
  "addOns": {
    "common": {
      "name": "Sheets拡張",
      "logoUrl": "https://www.gstatic.com/images/branding/product/1x/sheets_48dp.png"
    },
    "studio": {
      "flows": {
        "workflowElements": [
          {
            "id": "appendAdvancedRowsAction",
            "state": "ACTIVE",
            "name": "JSONデータから行を追加",
            "description": "JSON配列のキーとヘッダー行を照合し、指定した位置にデータを追加します",
            "workflowAction": {
              "inputs": [
                {
                  "id": "spreadsheet_url",
                  "cardinality": "SINGLE",
                  "description": "対象のスプレッドシートURL",
                  "dataType": {
                    "basicType": "STRING"
                  }
                },
                {
                  "id": "sheet_name",
                  "cardinality": "SINGLE",
                  "description": "対象のシート名",
                  "dataType": {
                    "basicType": "STRING"
                  }
                },
                {
                  "id": "insert_position",
                  "cardinality": "SINGLE",
                  "description": "データの追加位置",
                  "dataType": {
                    "basicType": "STRING"
                  }
                },
                {
                  "id": "json_data",
                  "cardinality": "SINGLE",
                  "description": "追加するデータのJSON配列",
                  "dataType": {
                    "basicType": "STRING"
                  }
                }
              ],
              "outputs": [
                {
                  "id": "result_status",
                  "cardinality": "SINGLE",
                  "description": "処理結果のステータス",
                  "dataType": {
                    "basicType": "STRING"
                  }
                }
              ],
              "onConfigFunction": "onAppendRowsConfig",
              "onExecuteFunction": "onAppendRowsExecute"
            }
          }
        ]
      }
    }
  }
}